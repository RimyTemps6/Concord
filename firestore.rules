rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Guarda o token de cadastro (config/signup -> campo "code"). Ninguém lê pelo app.
    match /config/{doc} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if signedIn();
      // O campo "admin" só pode ser definido pelo console do Firebase, nunca pelo site.
      allow create: if signedIn() && request.auth.uid == uid
        && !('admin' in request.resource.data)
        && request.resource.data.token == get(/databases/$(database)/documents/config/signup).data.code;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.get('admin', false) == resource.data.get('admin', false);
    }

    // Conversas (2 pessoas) e grupos (type == "group", até 50 pessoas)
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && (request.resource.data.members.size() == 2
          || (request.resource.data.get('type', '') == 'group'
              && request.resource.data.owner == request.auth.uid
              && request.resource.data.members.size() <= 50));
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && (request.resource.data.members == resource.data.members
          || (resource.data.get('owner', '') == request.auth.uid
              && request.resource.data.members.size() <= 50));

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    // Status: só quem está na lista "viewers" (contatos de quando foi postado) enxerga
    match /statuses/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.viewers;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
